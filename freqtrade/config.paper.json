{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "argo-desk-paper",
    "strategy": "ArgoDesk",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "stake_currency": "USD",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 5,
    "timeframe": "4h",
    "fee": 0.004,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": true,
        "stoploss_on_exchange_interval": 60
    },
    "exchange": {
        "name": "kraken",
        "pair_whitelist": [],
        "pair_blacklist": [
            ".*USD.*/USD",
            ".*EUR.*/USD",
            "(DAI|GHO|FRAX|UST|GBP|AUD|CHF|JPY|TRY|BRL)/USD"
        ]
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 40,
            "sort_key": "quoteVolume",
            "min_value": 1000000,
            "refresh_period": 1800
        }
    ],
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}

# Copia questo file in .env e modifica solo quello che ti serve.
# Tutti i valori qui sotto sono i default: senza .env il desk parte in paper trading.

# --- Analisti LLM (News, Sentiment, Skeptic, Chief) ---------------------------
# Senza chiave puoi comunque usare `desk scan`, `desk backtest` e `--rules-only`.
ANTHROPIC_API_KEY=
DESK_MODEL=claude-opus-5-5
DESK_LANGUAGE=italiano
DESK_MAX_CANDIDATES=2        # mercati discussi dagli analisti per ciclo (ogni discussione costa)
DESK_REANALYZE_HOURS=6       # non ridiscutere lo stesso mercato prima di N ore
DESK_MIN_CONFIDENCE=0.6      # sotto questa fiducia del Chief il BUY viene annullato

# --- Mercato -------------------------------------------------------------------
DESK_MODE=paper              # paper = soldi finti su prezzi veri | live = soldi veri
DESK_EXCHANGE=kraken         # kraken | bybiteu (Bybit per residenti UE) | bybit | bingx | altri id ccxt
DESK_QUOTE=USD               # Kraken: USD · Bybit EU: USDC o EUR · BingX: USDT (`desk scan` elenca le valute)
DESK_CAPITAL=1000            # l'unico capitale che il desk può usare, nella valuta sopra
DESK_TIMEFRAME=4h            # il desk fa un ciclo completo a ogni chiusura di candela
DESK_UNIVERSE_SIZE=40        # quanti mercati (i più liquidi) vengono scansionati
DESK_MIN_QUOTE_VOLUME=1000000
DESK_RVOL_MIN=2.0            # volume recente / volume abituale per attirare lo Scout
DESK_BREAKOUT_LOOKBACK=20    # compra solo se chiude sopra il massimo di tante candele (0 = spento)
DESK_REWARD_RISK=3          # target a 3 volte la distanza dello stop
DESK_ATR_STOP_MULT=3        # stop a 3 ATR (volatilità media) dall'entrata

# --- Limiti di rischio (li applica il codice, nessun agente può aggirarli) -----
DESK_RISK_PER_TRADE_PCT=1    # % del capitale persa se scatta lo stop
DESK_MAX_POSITION_PCT=10     # % massima del capitale in una posizione
DESK_MAX_EXPOSURE_PCT=50     # % massima del capitale investita in totale
DESK_MAX_OPEN_POSITIONS=5
DESK_MAX_DAILY_LOSS_PCT=3    # oltre questa perdita niente nuove entrate fino a domani (UTC)
DESK_MAX_DRAWDOWN_PCT=15     # oltre questo calo dal picco il desk si ferma (serve `desk resume`)
DESK_MAX_COST_R=0.33         # scarta i trade in cui commissioni e slippage superano 1/3 del rischio
DESK_REGIME_FILTER=true      # filtro di mercato su BTC
DESK_REGIME_STRICT=true      # true: compra solo con BTC in salita · false: solo se BTC non scende

# --- Costi: usa la commissione taker reale del tuo exchange --------------------
DESK_FEE_RATE=0.004          # 0.004 = 0,4% (Kraken taker): metti la commissione taker spot del tuo conto
DESK_SLIPPAGE_BPS=10

# --- Desk dei perpetui (solo soldi finti) --------------------------------------
# Si avvia con start-perps.bat (Windows) o ./start-perps.sh, accanto al desk spot.
# Legge questo stesso .env, ma usa sempre i perpetui in USDT di DESK_PERPS_EXCHANGE
# (Bybit: dal PC Binance non risponde), un database suo
# (data/desk-paper-perps.db) e solo soldi finti. DESK_MARKET non va messo qui:
# lo imposta start-perps.
DESK_PERPS_EXCHANGE=bybit        # da dove legge i perpetui: bybit, okx (binanceusdm dal PC non va)
DESK_PERPS_FEE_RATE=0.00055      # commissione dei perpetui sul valore intero della posizione
DESK_PERPS_CAP_POSITION_PCT=33   # valore massimo di una posizione, in % del capitale
DESK_PERPS_CAP_TOTAL_PCT=150     # valore massimo di tutte le posizioni insieme
DESK_PERPS_MAX_LEVERAGE=3        # leva massima di una posizione
DESK_PERPS_OI_FILTER=true        # entra solo se i contratti aperti sulla moneta crescono da 24 ore

# --- Solo per DESK_MODE=live ---------------------------------------------------
# Crea una chiave API con il solo permesso di trading spot: prelievi DISATTIVATI.
DESK_EXCHANGE_API_KEY=
DESK_EXCHANGE_API_SECRET=
DESK_EXCHANGE_API_PASSWORD=

# --- Pagina live (facoltativo) -------------------------------------------------
# Il desk invia ogni minuto i suoi dati alla pagina ARGO DESK Live su claude.ai,
# passando da Supabase. Senza questi tre valori non invia nulla.
DESK_LIVE_URL=             # https://<progetto>.supabase.co (solo https)
DESK_LIVE_KEY=
DESK_LIVE_TOKEN=
